{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CCBaga-A",
        "width": 1040,
        "height": 820,
        "minWidth": 760,
        "minHeight": 640,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb",
      "appimage"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "zsh",
          "xdg-utils",
          "libnss3",
          "libnspr4",
          "libgbm1",
          "libasound2",
          "libxss1",
          "curl"
        ],
        "files": {
          "/usr/share/applications/ccbaga-browser.desktop": "../browser-runtime/ccbaga-browser.desktop",
          "/usr/share/icons/hicolor/512x512/apps/ccbaga-browser.png": "../browser-runtime/icons/icon.png",
          "/usr/libexec/CCBaga-B/": "../browser-runtime/LinuxBrowser/"
        }
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3",
          "zsh",
          "xdg-utils",
          "nss",
          "nspr",
          "mesa-libgbm",
          "alsa-lib",
          "libXScrnSaver",
          "curl"
        ],
        "files": {
          "/usr/share/applications/ccbaga-browser.desktop": "../browser-runtime/ccbaga-browser.desktop",
          "/usr/share/icons/hicolor/512x512/apps/ccbaga-browser.png": "../browser-runtime/icons/icon.png",
          "/usr/libexec/CCBaga-B/": "../browser-runtime/LinuxBrowser/"
        },
        "compression": {
          "type": "zstd",
          "level": 3
        }
      },
      "appimage": {
        "files": {
          "usr/share/applications/ccbaga-browser.desktop": "../browser-runtime/ccbaga-browser.desktop",
          "usr/share/icons/hicolor/512x512/apps/ccbaga-browser.png": "../browser-runtime/icons/icon.png",
          "usr/libexec/CCBaga-B/": "../browser-runtime/LinuxBrowser/"
        }
      }
    }
  }
}
